From mizzle.lang Require Import
  prelude.
From mizzle.lang Require Import
  instances.
From tests Require Import
  unboxed_record__types.
From mizzle.lang Require Import
  options.

Definition unboxed_record٠test1 : val :=
  vfun: "x" =>
    "x".

Definition unboxed_record٠test2 : val :=
  vfun: "t" =>
    match: "t" with
    |_ as "x" =>
        "x"
    end.

Definition unboxed_record٠test3 : val :=
  vfun: "t" =>
    let: "x" := "t" in
    "x".
