Definition let_pattern٠test1 : val :=
  vfun: <> =>
    let: "x", "y" := (0, 1) in
    "x" + "y".

Definition let_pattern٠test2 : val :=
  vfun: <> =>
    let: ‘Some "i" := ‘Some( 0 ) in
    "i".
