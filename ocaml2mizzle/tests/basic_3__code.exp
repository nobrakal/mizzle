From mizzle.lang Require Import
  prelude.
From mizzle.lang Require Import
  instances.
From tests Require Import
  basic_3__types.
From mizzle.lang Require Import
  options.

Definition basic_3٠test1 : val :=
  vfun: "x1" "x2" =>
    "x1" + "x2".

Definition basic_3٠test2 : val :=
  vfun: "x" <> =>
    "x".

Definition basic_3٠test3 : val :=
  vfun: "x1" "x2" "x3" =>
    "x1" + "x2" + "x3".

Definition basic_3٠test4 : val :=
  vfun: <> "x" <> =>
    "x".
