From mizzle.lang Require Import
  prelude.
From mizzle.lang Require Import
  instances.
From tests Require Import
  operators_1__types.
From mizzle.lang Require Import
  options.

Definition operators_1٠test1 : val :=
  vfun: "i" =>
    ~ true ;;
    - "i" ;;
    "i" + "i" ;;
    "i" - "i" ;;
    "i" * "i" ;;
    ("i" `quot` "i") ;;
    ("i" `rem` "i") ;;
    "i" `land` "i" ;;
    "i" `lor` "i" ;;
    "i" `lsl` "i" ;;
    "i" `lsr` "i" ;;
    "i" == "i" ;;
    "i" != "i" ;;
    "i" ≤ "i" ;;
    "i" < "i" ;;
    "i" ≥ "i" ;;
    "i" > "i" ;;
    2 * "i" + ("i" + 1) < "i" ;;
    true and true ;;
    true or true ;;
    true and true or true ;;
    true and (true or true) ;;
    true or true and true ;;
    (true or true) and true ;;
    ().

Definition operators_1٠test2 : val :=
  vfun: "i" =>
    (fun: "1" "2" => "1" + "2") ;;
    (fun: "1" "2" => "1" + "2") "i" ;;
    "i" + "i" ;;
    ().
