From mizzle.lang Require Import
  prelude.
From mizzle.lang Require Import
  instances.
From tests Require Import
  variant_4__types.
From mizzle.lang Require Import
  options.

Definition variant_4٠test1 : val :=
  vfun: "t" =>
    match: "t" with
    | A =>
        0
    | B <> <> as "r" =>
        "r".{f1}
    end.

Definition variant_4٠test2 : val :=
  vfun: "t" =>
    match: "t" with
    | A =>
        0
    | B <> <> as "t" =>
        let: "r" := "t" in
        "t" ;;
        "r".{f1}
    end.

Definition variant_4٠test3 : val :=
  vfun: "t" =>
    match: "t" with
    | A =>
        §A
    | B <> <> as "r" =>
        "r"
    end.

Definition variant_4٠test4 : val :=
  vfun: "t" =>
    match: "t" with
    | A =>
        §A
    | B <> <> as "t" =>
        let: "r" := "t" in
        "t" ;;
        "r"
    end.
