From mizzle.lang Require Import
  prelude.
From mizzle.lang Require Import
  instances.
From tests Require Import
  option__types.
From mizzle.lang Require Import
  options.

Definition option٠test1 : val :=
  vfun: <> =>
    §None ;;
    ‘Some( 0 ) ;;
    ().

Definition option٠test2 : val :=
  vfun: "o" =>
    match: "o" with
    | None =>
        0
    | Some "i" =>
        "i"
    end.
