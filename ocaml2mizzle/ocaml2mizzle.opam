# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "OCaml to MizzleLang"
maintainer: ["Alexandre Moine <alexandre.moine@inria.fr>"]
authors: ["Clément Allain" "Alexandre Moine"]
license: "ISC"
homepage: "https://github.com/nobrakal/mizzle"
bug-reports: "https://github.com/nobrakal/mizzle/issues"
depends: [
  "dune" {>= "3.0"}
  "ocaml-compiler-libs"
  "csexp"
  "fmt"
  "cmdliner"
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/nobrakal/mizzle.git"
